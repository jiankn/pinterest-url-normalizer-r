\name{parse_pinterest_url}
\alias{parse_pinterest_url}
\title{Parse a Pinterest URL}
\usage{parse_pinterest_url(url)}
\arguments{\item{url}{A single character string.}}
\value{A list with \code{kind}, \code{normalized_url}, and \code{identifier}.}
\description{Parses one URL without following redirects or making any network request.}
